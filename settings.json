{
  "enabledPlugins": {
    "voicemode@voicemode": true,
    "test-automator@voltagent-subagents": true
  },
  "extraKnownMarketplaces": {
    "voicemode": {
      "source": {
        "source": "github",
        "repo": "mbailey/voicemode"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "mcpServers": {
    "google-calendar": {
      "command": "npx",
      "args": [
        "-y",
        "@your-mcp-package/google-calendar"
      ],
      "env": {
        "YOUR_API_KEY": "..."
      }
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-your-token-here",
        "SLACK_TEAM_ID": "your-team-id-here"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "voiceEnabled": true,
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "PowerShell",
      "Bash(pip show *)",
      "Bash(pip list *)",
      "Bash(pip3 show *)",
      "Bash(pip freeze)",
      "Bash(.venv/Scripts/pip show *)",
      "Bash(.venv/Scripts/pip3.exe show *)",
      "Bash(uv pip show *)",
      "Bash(uv pip list)",
      "Bash(.venv/Scripts/python.exe --version)",
      "WebSearch"
    ]
  }
}
